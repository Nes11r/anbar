# ---- Database (PostgreSQL 16) ----
# Local docker-compose default. Change the password on any shared machine.
DATABASE_URL="postgresql://hecotec:CHANGE_ME_LOCAL_ONLY@localhost:5433/hecotec_wms?schema=public&connection_limit=20&pool_timeout=15"
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_ONLY"

# Separate database used only by integration tests (it is wiped on every test run!)
TEST_DATABASE_URL="postgresql://hecotec:CHANGE_ME_LOCAL_ONLY@localhost:5433/hecotec_wms_test?schema=public&connection_limit=20"

# ---- App ----
APP_URL="http://localhost:3000"
SESSION_TTL_HOURS=12
# "true" only when served over HTTPS
COOKIE_SECURE="false"

# ---- First Super Admin (read once by `npm run admin:create`) ----
# Never commit real passwords. Remove these values after the admin is created.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Sistem Admin"

# ---- Files ----
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"

# ---- Production (Hetzner / docker compose --profile full) ----
# Public domain pointing (DNS A record) to the server IP. HTTPS certificate is obtained automatically.
DOMAIN="anbar.hecotec.az"
ACME_EMAIL="it@hecotec.az"
# In production set: APP_URL="https://anbar.hecotec.az"  COOKIE_SECURE="true"
